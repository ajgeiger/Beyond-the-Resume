# Copy to .env and fill in what you use. Never commit .env.

# Which model writes answers: anthropic, openai, fake or auto.
# auto uses Anthropic when ANTHROPIC_API_KEY is set, then OpenAI, else the offline fake.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: a different model for the active provider, for example a larger one.
LLM_MODEL=
# Optional: any OpenAI compatible server (Hugging Face Inference Endpoint, vLLM). Use with LLM_PROVIDER=openai.
LLM_BASE_URL=
MAX_OUTPUT_TOKENS=700

# Spend cap in US dollars per calendar month. Model calls stop when it is reached.
MONTHLY_BUDGET_USD=20

# Optional: require this key in X-API-Key or Authorization: Bearer on /chat, /retrieve and /info.
CHATBOT_API_KEY=

# Server
HOST=127.0.0.1
PORT=8070

# Set to true to turn on the cross encoder reranker (slower, more accurate first result).
RERANK=false

# Optional: folder with the baked or downloaded MiniLM ONNX files.
EMBEDDING_MODEL_DIR=
